{
  "name": "404-society-official",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": { "directory": "./", "binding": "ASSETS" },
  "vars": {
    "SHOPIFY_DOMAIN": "404-society-cloudflare.myshopify.com",
    "SHOPIFY_STOREFRONT_PUBLIC_TOKEN": "YOUR-STOREFRONT-TOKEN",
    "CASHFREE_ENV": "sandbox",
    "GOOGLE_CLIENT_ID": "YOUR-CLIENT-ID.apps.googleusercontent.com",
    "SHIP_THRESHOLD": "2000",
    "SHIP_BELOW": "0",
    "SHIP_ABOVE": "99"
  },
  "kv_namespaces": [
    { "binding": "ORDERS", "id": "YOUR-KV-ID" }
  ]
}
