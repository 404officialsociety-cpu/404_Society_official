{
  "name": "404-society-official",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "vars": {
    "SHOPIFY_DOMAIN": "404-society-cloudflare.myshopify.com",
    "SHOPIFY_STOREFRONT_PUBLIC_TOKEN": "PASTE-STOREFRONT-TOKEN-HERE",
    "SHOPIFY_API_VERSION": "2026-04",
    "CASHFREE_ENV": "sandbox",
    "GOOGLE_CLIENT_ID": "PASTE-CLIENT-ID.apps.googleusercontent.com",
    "SHIP_THRESHOLD": "2000",
    "SHIP_BELOW": "0",
    "SHIP_ABOVE": "99"
  },
  "kv_namespaces": [
    { "binding": "ORDERS", "id": "PASTE-KV-NAMESPACE-ID-HERE" }
  ]
}
