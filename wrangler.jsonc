"keep_vars": true,
"vars": {
  "SHOPIFY_DOMAIN": "404-society-cloudflare.myshopify.com",
  "SHOPIFY_API_VERSION": "2026-04",
  "CASHFREE_ENV": "sandbox",
  "GOOGLE_CLIENT_ID": "YOUR-REAL-CLIENT-ID.apps.googleusercontent.com",
  "SHIP_THRESHOLD": "2000",
  "SHIP_BELOW": "0",
  "SHIP_ABOVE": "99"
},
"kv_namespaces": [
  { "binding": "ORDERS", "id": "YOUR-KV-NAMESPACE-ID" }
]
